&model
  pmix_len         = 8.0e+01 ! mixing length
  turh             = 5.0e+04 ! turbulence coefficient
  storm_name = 'florence'
  bot_top    = .false.
  check_bound_time_beg = -1.0
  check_bound_time_end = -1.0
/
&diagnostics
 diag_file = 'OUTPUT/model_5ms_50cm_30min_landfall.nc '
/
&parametric
  param_file = 'INPUT/parametric_5ms_50cm_30min_landfall.nc '
/
